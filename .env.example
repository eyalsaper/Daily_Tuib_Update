# Firebase web app config for the teamcheck-6ea23 project.
# Copy this file to .env and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# These are client-side keys: they are not secrets in the cryptographic sense,
# but they identify a project that holds real employee data. Access control
# comes entirely from firestore.rules — deploy those before going live.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=teamcheck-6ea23.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=teamcheck-6ea23
VITE_FIREBASE_STORAGE_BUCKET=teamcheck-6ea23.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=795606793027
VITE_FIREBASE_APP_ID=

# Firestore data root: artifacts/{VITE_APP_ID}/public/data/{collection}
VITE_APP_ID=teamcheck-6ea23

# Team whose task configuration is loaded from team_configs/{team}
VITE_TEAM=צוות טיוב

# Authentication mode:
#   legacy   - sign in against the users collection (SHA-256 password hash),
#              exactly like midrag-app-legacy.html. Works today, cannot be secured.
#   firebase - Firebase Authentication (email/password). Requires the accounts to
#              exist and profile docs to carry authUid (see scripts/migrate-auth.mjs).
VITE_AUTH_MODE=legacy
